 num_bands       = 40
 num_wann        = 32
 exclude_bands : 1-16, 57-64   !!! IMPORTANT !!!

!!! Disentanglement parameters !!!
!dis_froz_min     = 7.
 dis_froz_max     = 6.7
 dis_mix_ratio    = 0.5

!!! Iterations &c. !!!
 iprint                = 1
 num_iter              =     0
 num_print_cycles      =   100
 conv_window           = 3
!conv_tol              = 1e-10
 dis_num_iter          = 10000
!dis_conv_window       = 3
!dis_conv_tol          = 1e-10
!restart               = default ! wannierise ! plot ! transport

!!! Post-processing options !!!
 write_proj             = .true.
 write_xyz              = .true.
 translate_home_cell    = .false.   !!! IMPORTANT !!!
 hr_plot                = .true.    !!! IMPORTANT !!!
!fermi_surface_plot     = .true.
!dos                    = .false.
!dos_project            =
!dos_kmesh              = 50 50 1
!dos_energy_min         = -1.8
!dos_energy_max         = +1.5

!!! Band structure !!!
!!! needs `kpoint_path' block
!bands_plot             = .true.
 bands_num_points       = 50
!bands_plot_format      = gnuplot xmgrace
!bands_plot_project     = 1-3
!bands_plot_mode        = s-k | cut [Slater-Koster | truncate Hamiltonian]

!!! Spin-orbit coupling !!!
use_bloch_phases = .true.           !!! IMPORTANT !!!
spinors = .true.                    !!! IMPORTANT !!!

!!! BZ-Path for band structure !!!
bands_plot = T
begin kpoint_path
  K   0.3333333333333333   0.3333333333333333   0.00000    G   0.00000   0.00000   0.00000
  G   0.00000   0.00000   0.00000    A   0.00000   0.00000   0.50000
  A   0.00000   0.00000   0.50000    K   0.3333333333333333   0.3333333333333333   0.00000
  K   0.3333333333333333   0.3333333333333333   0.00000    H   0.3333333333333333   0.3333333333333333   0.50000
  H   0.3333333333333333   0.3333333333333333   0.50000    M   0.50000   0.00000   0.00000
  M   0.50000   0.00000   0.00000    L   0.50000   0.00000   0.50000
end kpoint_path

!!!! Dummy `projections' block for guiding centres !!!
guiding_centres = T
begin projections
Mn:l=2
Te:l=1
end projections

