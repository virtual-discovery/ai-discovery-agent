{
 "task_id": "gan-irradiation-defect-levels",
 "catalog_id": "gan-irradiation-defect-levels",
 "start": "released",
 "source_group": "hauck_2026_gan_defects",
 "title": "Irradiated GaN: native-defect charge-transition levels and Frenkel-pair pinning",
 "decision_points": [
  {
   "id": "dp1",
   "kind": "evidence in run metadata (k-point) and eigenvalues",
   "fork": "Band edges: every defect cell and `perfect` use the single k-point (1/2,1/2,1/2), where the supercell eigenvalues are folded states (gap ~6.5 eV); the edges must come from the Gamma-only perfect cell with the same PAW set",
   "wrong_choice": "Take the VBM/CBM from the HOMO/LUMO of `perfect` (R point), or the perfect-cell Fermi energy as VBM",
   "consequence": "Gap 6.53 eV and every level +0.66 eV (R point); levels +0.33 eV (Fermi energy); pair energies at E_CBM - 0.5 eV off by eV",
   "ablation": "band_edges_from_R_point_supercell",
   "other_ablations": [
    "vbm_from_perfect_cell_fermi_energy"
   ]
  },
  {
   "id": "dp2",
   "kind": "metadata consistency, cascade into pair energies",
   "fork": "Host total energy: the perfect cell computed like the defect cells (same k-point and PAW set) versus the Gamma-only perfect cell that supplies the band edges",
   "wrong_choice": "Use the Gamma-only perfect cell (4.71 eV higher) as the host energy",
   "consequence": "Levels unchanged but E_b -4.71 eV (divacancy apparently unbound) and both Frenkel energies -9.42 eV",
   "ablation": "host_energy_from_gamma_only_supercell"
  },
  {
   "id": "dp3",
   "kind": "model choice (screening of relaxed charged defects)",
   "fork": "Dielectric screening for relaxed charged defects: static eps_0 versus electronic eps_inf, or no correction",
   "wrong_choice": "eps_inf (corrections ~1.8x larger), or no finite-size correction",
   "consequence": "eps_inf makes the 2+ states of V_N (0.12 eV window) and Ga_i (0.17 eV) stable, moves V_Ga (2-/3-) by +0.46 eV, E_b by +0.55 eV and the Ga Frenkel energy by +0.92 eV; no correction compresses the V_Ga ladder (levels within 0.17 eV) and removes the V_N neutral state",
   "ablation": "electronic_dielectric_tensor",
   "other_ablations": [
    "no_finite_size_correction"
   ]
  },
  {
   "id": "dp4",
   "kind": "model choice, cascade",
   "fork": "Potential alignment from the core potentials far from the defect (eFNV) versus the point-charge term alone",
   "wrong_choice": "Makov-Payne-like point-charge correction without alignment",
   "consequence": "V_Ga levels -0.10 to -0.13 eV, V_N (3+/+) -0.13 eV, Frenkel energies -0.41 (Ga) and +0.15 eV (N)",
   "ablation": "point_charge_term_without_alignment"
  },
  {
   "id": "dp5",
   "kind": "evidence in raw outputs (sign convention)",
   "fork": "Sign of VASP's 'average (electrostatic) potential at core': it is an electron potential energy, so the defect-induced change anticorrelates with the point-charge potential (r ~ -0.85 far from localized defects)",
   "wrong_choice": "Read the core potentials as electrostatic potentials, flipping the sign of the DFT part of the alignment",
   "consequence": "V_Ga ladder compressed (1.27-1.70 eV), V_N loses its neutral state, Ga_i (3+/+) +0.61 eV, E_b -0.59 eV, Ga Frenkel energy -2.1 eV",
   "ablation": "core_potentials_read_as_electrostatic_potentials"
  },
  {
   "id": "dp6",
   "kind": "discriminating purchases under budget (site switching with charge)",
   "fork": "Lowest-energy configuration per charge state: buy both interstitial sites for each charge",
   "wrong_choice": "Use one archived site (i1) for every charge state",
   "consequence": "Ga_i (3+/+) +0.52 eV plus a spurious (+/0) at 3.25 eV; no N_i level left in the graded window; Frenkel energies +1.04 (Ga) and +1.11 eV (N)",
   "ablation": "single_interstitial_site_i1"
  },
  {
   "id": "dp7",
   "kind": "thermodynamic stability (negative U)",
   "fork": "Levels between consecutive thermodynamically stable states versus every adjacent pair (q/q-1)",
   "wrong_choice": "Report (3+/2+) and (2+/+) for V_N and Ga_i although 2+ is never stable",
   "consequence": "Two levels in inverted order instead of the single (3+/+) level (V_N: U = -0.07 eV; Ga_i: U ~ 0, with any 2+ window below the 0.1 eV merge width)",
   "ablation": "adjacent_charge_levels_without_stability"
  },
  {
   "id": "dp8",
   "kind": "metadata inconsistency (PAW set)",
   "fork": "Which Gamma-point perfect run gives the band edges: WAV_ref (Gamma, on the exact host geometry) and kpt_gam/d10 use the Ga_d PAW set (864 electrons) with an incompatible eigenvalue scale; kpt_gam uses the defect cells' Ga set",
   "wrong_choice": "Take the band edges from WAV_ref (its gap, 3.51 eV, looks reasonable)",
   "consequence": "VBM 2.33 eV too high: most levels collapse below midgap or vanish; gap -0.05 eV",
   "ablation": "band_edges_from_Ga_d_paw_run"
  }
 ],
 "graded_fields": [
