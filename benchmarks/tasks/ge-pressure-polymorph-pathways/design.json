 "title": "Ge under pressure: diamond, beta-Sn and the metastable decompression phases",
 "decision_points": [
  {
   "id": "dp1",
   "fork": "Which archived frames are equilibrium energies",
   "wrong_choice": "Use every purchased frame, including rattled training configurations (forces 1-3 eV/A, shear stress)",
   "consequence": "CD/bSn pressure 7.6 GPa, bSn/BC8 4.4 GPa, wrong metastable order",
   "ablation": "rattled_frames_included"
  },
  {
   "id": "dp2",
   "fork": "Where the pressure comes from",
   "wrong_choice": "Use the printed stress of every frame, H = E + P_printed V; intermediate relaxation steps scatter by up to ~4 GPa",
   "consequence": "All pressures 0.8-2 GPa low; R8-BC8 difference and order wrong",
   "ablation": "enthalpy_from_printed_stress"
  },
  {
   "id": "dp3",
   "fork": "Enthalpy crossing vs comparing equation-of-state minima",
   "wrong_choice": "P = dE0/dV0 between E(V) minima",
   "consequence": "Pressures 0.5-1.2 GPa low",
   "ablation": "linear_dE_over_dV"
  },
  {
   "id": "dp4",
   "fork": "Whether the archived compressed metastable structures are relaxed",
   "wrong_choice": "Take ISIF = 6 / scaled ST12, BC8, R8 frames as they are (internal coordinates frozen at 0 GPa values, residual forces up to 0.5 eV/A)",
   "consequence": "bSn/ST12 crossing 6.6 instead of 7.5 GPa",
   "ablation": "archived_structures_uncorrected"
  },
  {
   "id": "dp5",
   "fork": "Surrogate vs DFT where few-meV differences decide",
   "wrong_choice": "Use the DeePMD potential for the enthalpies (all phases or the metastable ones)",
   "consequence": "E(ST12)-E(BC8) 5.2 instead of 2.9 meV/atom; bSn/BC8 6.1-6.2 GPa",
   "ablation": "surrogate_only"
  },
  {
   "id": "dp6",
   "fork": "How to handle frames with residual forces",
   "wrong_choice": "Discard every frame with force > 0.05 eV/A, leaving only near-zero-pressure metastable data and extrapolating",
   "consequence": "bSn/ST12 crossing 6.4 GPa; bSn/BC8 no crossing in range",
   "ablation": "force_filter_discards_compressed_frames"
  },
  {
   "id": "dp7",
   "fork": "Whether relaxations reached their PSTRESS target",
   "wrong_choice": "Treat PSTRESS as the pressure of the final step (H = E + PSTRESS V); the CD 10 GPa run stopped at ~5.6 GPa",
   "consequence": "CD/bSn pressure 8.54 instead of 8.79 GPa",
   "ablation": "pstress_as_pressure"
  }
 ],
