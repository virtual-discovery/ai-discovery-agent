schema_version = "1.3"
artifacts = [{source = "/app/submission.json", destination = "submission.json"}, {source = "/app/report.md", destination = "report.md"}, {source = "/lab-results", destination = "lab-results", service = "lab"}]
[task]
name = "ai-theorist/{task_id}"
description = "{title}"
authors = [{name = "AI Theorist benchmark team"}]
[metadata]
table = 1
start = "{start}"
source_study = "{source_group}"
catalog_id = "{catalog_id}"
split = "evaluation"
[agent]
timeout_sec = {agent_timeout}
user = "agent"
[verifier]
timeout_sec = 300
environment_mode = "separate"
[environment]
cpus = {cpus}
memory_mb = {memory_mb}
storage_mb = 16384
